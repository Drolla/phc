# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.benchmarks/
.mypy_cache/
.ruff_cache/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Generated logs (e.g. logdb CSV output, extensions.recovery's persisted
# endpoint values, extensions.timer's user-edited timers, or a log: file
# destination written next to whichever system YAML configured it)
logs/
*.log

# Claude Code local settings
.claude/settings.local.json

# Personal home automation config (may become a symlink to a backed-up
